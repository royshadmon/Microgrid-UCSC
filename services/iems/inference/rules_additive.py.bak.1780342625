"""Post-inference rules: additive disambiguation, mutual exclusion, battery window.

These operate on the MATNilm dual-head output (per-appliance on/off prob +
estimated watts) plus the measured panel power, encoding domain facts that the
network is not guaranteed to satisfy on limited weak-labeled data.

Signature table (from the Mantey-site appliance inventory):
  (on_threshold_w, lo_w, hi_w)  — power band when ON.
"""
from __future__ import annotations

from datetime import datetime
from typing import Optional

# Battery is charged daily 16:00-21:00 local at the Mantey site.
BATTERY_WINDOW = (16, 21)  # [start_hour, end_hour)

# At most one of each group may be ON simultaneously.
#   heat_pump and solar_pump are physically interlocked: when the solar water
#   pump runs the heat pump is off, and vice versa.
MUTEX_GROUPS = (("heat_pump", "solar_pump"),)

# on_threshold_w, lo_w, hi_w
APPLIANCE_SIGNATURE = {
    "heat_pump":        (300, 1500, 4000),   # 550 W fan-only is a low sub-state
    "heat_pump_fan":    (300,  450,  650),
    "solar_pump":       (50,   100,  250),
    "water_heater":     (500, 2000, 4000),
    "hair_dryer":       (800, 1200, 1800),
    "sprinklers":       (50,   100,  300),
    "bath_lights":      (80,   100,  300),   # master-bath mirror incandescent
    "refrigerator":     (50,    80,  200),   # kitchen + garage fridge + freezer
    "dishwasher":       (50,   200, 1800),
    "microwave":        (200,  900, 1500),
    "dryer":            (1000, 4000, 7000),
    "washing_machine":  (50,   200, 2000),
    "pressure_pump":    (200,  500, 1000),
    "computers":        (100,  200,  500),
    "tv_stereo":        (80,   100,  200),
    "vacuum_cleaner":   (600,  800, 1200),
    "garage_opener":    (100,  300,  600),
}


def is_battery_window(ts_local: datetime) -> bool:
    return BATTERY_WINDOW[0] <= ts_local.hour < BATTERY_WINDOW[1]


def apply_mutual_exclusion(preds: dict) -> dict:
    """For each mutex group, keep only the highest-confidence ON member."""
    for group in MUTEX_GROUPS:
        present = [a for a in group if a in preds]
        on = [a for a in present if preds[a]["state"] == 1]
        if len(on) > 1:
            winner = max(on, key=lambda a: preds[a]["confidence"])
            for a in on:
                if a != winner:
                    preds[a]["state"] = 0
                    preds[a]["power_w"] = 0.0
                    preds[a]["rule"] = f"mutex:lost_to_{winner}"
    return preds


def additive_disambiguation(preds: dict, panel_power_w: float,
                            on_tol_w: float = 250.0) -> dict:
    """Reconcile the predicted ON set against measured panel power.

    Additive recovery: if the panel power left unexplained by the currently-ON
    appliances is large enough to match an OFF appliance's signature band, that
    appliance is also ON (two similar-signature loads stacking show up only as
    their sum in the net). Symmetric trimming removes the weakest ON appliance
    when the predicted sum substantially overshoots the measured panel power.
    """
    def predicted_sum():
        return sum(p["power_w"] for p in preds.values() if p["state"] == 1)

    # --- additive recovery ---
    residual = panel_power_w - predicted_sum()
    # Try to explain a positive residual with OFF appliances, best-fit first.
    while residual > on_tol_w:
        best = None
        for a, p in preds.items():
            if p["state"] == 1 or a not in APPLIANCE_SIGNATURE:
                continue
            thr, lo, hi = APPLIANCE_SIGNATURE[a]
            if residual >= thr:
                # how well the appliance's nominal band fits the residual
                center = (lo + hi) / 2.0
                fit = abs(residual - center)
                if best is None or fit < best[1]:
                    best = (a, fit, min(max(residual, lo), hi))
        if best is None:
            break
        a, _, assigned_w = best
        preds[a]["state"] = 1
        preds[a]["power_w"] = float(assigned_w)
        preds[a]["rule"] = "additive_recovery"
        residual = panel_power_w - predicted_sum()

    # --- overshoot trimming ---
    overshoot = predicted_sum() - panel_power_w
    while overshoot > on_tol_w:
        on = [(a, p) for a, p in preds.items() if p["state"] == 1]
        if len(on) <= 1:
            break
        victim = min(on, key=lambda ap: ap[1]["confidence"])[0]
        overshoot -= preds[victim]["power_w"]
        preds[victim]["state"] = 0
        preds[victim]["power_w"] = 0.0
        preds[victim]["rule"] = "overshoot_trim"
    return preds


def apply_rules(preds: dict, panel_power_w: float, ts_local: Optional[datetime] = None,
                additive: bool = True) -> dict:
    """Full post-inference reconciliation for one panel/window.

    preds: {appliance: {"state": 0/1, "confidence": float, "power_w": float}}
    """
    for p in preds.values():
        p.setdefault("rule", "model")
    preds = apply_mutual_exclusion(preds)
    if ts_local is not None and is_battery_window(ts_local):
        for p in preds.values():
            p["battery_window"] = True
    if additive:
        preds = additive_disambiguation(preds, panel_power_w)
    return preds
