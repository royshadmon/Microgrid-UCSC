"""
SOLE AnyLog query module for IEMS.

READ PATH  — direct postgres (psycopg2)
  AnyLog destination:network REST queries time out due to Docker hairpin NAT
  (REST server inside Docker cannot TCP-route back to host.docker.internal:32148).
  All SELECT queries go directly to postgres using _pg_query().
  Partition tables are discovered dynamically and unioned client-side.

WRITE PATH — AnyLog REST PUT streaming ingestion (still works)
  insert_predictions() uses PUT / with command header — no routing needed.

Admin commands (get processes, blockchain get, etc.) still use anylog_admin().

KNOWN ANYLOG QUIRKS (kept for reference):
  - IN clause with parenthesized literals → IncompleteRead
  - LIKE with wildcards → IncompleteRead
  - WHERE nm = 'Panel1 (HVAC)' → empty result (parser quirk)
  - destination:network → timeout (hairpin NAT)
  Workaround for all read paths: query postgres directly.
"""
import http.client
import json
import logging
import os
import re
import statistics
import urllib.request
from datetime import datetime, timedelta, timezone

import psycopg2
import psycopg2.extras

logger = logging.getLogger(__name__)

ANYLOG_URL = os.environ.get("ANYLOG_REST_URL", "http://127.0.0.1:32149")
ANYLOG_USER_AGENT = "AnyLog/1.23"
ANYLOG_DBMS = "customers"
ANYLOG_TABLE_LIVE = "egauge_kafka"
ANYLOG_TABLE_NILM = "nilm_disaggregated"

# Panels tracked by the IEMS
IEMS_PANELS = (
    "Grid Power",
    "Generac Power",
    "Panel1 (HVAC)",
    "Panel2 (H2O)",
    "Panel3 (Kitchen)",
    "Shop",
)

PAREN_CHANNELS = frozenset({
    "Panel1 (HVAC)",
    "Panel2 (H2O)",
    "Panel3 (Kitchen)",
})

# ─── Postgres direct backend ──────────────────────────────────────────────────

_PG_DSN = {
    "host":     os.environ.get("PGHOST",     "127.0.0.1"),
    "port":     int(os.environ.get("PGPORT", "5432")),
    "dbname":   os.environ.get("PGDATABASE", "customers"),
    "user":     os.environ.get("PGUSER",     "demo"),
    "password": os.environ.get("PGPASSWORD", "passwd"),
}

_PARTITION_CACHE: dict[str, list[str]] = {}


def _pg_conn():
    return psycopg2.connect(**_PG_DSN)


def _get_partitions(table: str) -> list[str]:
    """Return all partition table names for `table`, newest first."""
    cached = _PARTITION_CACHE.get(table)
    if cached:
        return cached
    with _pg_conn() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """SELECT table_name FROM information_schema.tables
                   WHERE table_schema='public' AND table_name LIKE %s
                   ORDER BY table_name DESC""",
                (f"par_{table}_%",),
            )
            parts = [r[0] for r in cur.fetchall()]
    _PARTITION_CACHE[table] = parts
    return parts


def _rewrite_for_pg(sql: str, table: str) -> str:
    """
    Rewrite an AnyLog SQL string for direct postgres execution.
    - Replaces NOW() - N minutes/hours with postgres INTERVAL syntax
    - Replaces the bare table name with a UNION ALL over all partitions
    """
    # Fix AnyLog NOW() - N unit syntax
    sql = re.sub(
        r"NOW\(\)\s*-\s*(\d+)\s*(minutes?|hours?|days?)",
        lambda m: f"NOW() - INTERVAL '{m.group(1)} {m.group(2)}'",
        sql,
        flags=re.IGNORECASE,
    )
    parts = _get_partitions(table)
    if not parts:
        logger.warning("No partitions found for table %s", table)
        return sql
    union = " UNION ALL ".join(f"SELECT * FROM {p}" for p in parts)
    rewritten = re.sub(
        rf'\b{re.escape(table)}\b',
        f"({union}) AS {table}",
        sql,
        count=1,
    )
    return rewritten


def _pg_query(sql: str, table: str = ANYLOG_TABLE_LIVE) -> list[dict]:
    """Execute SQL directly against postgres, return list of row dicts."""
    rewritten = _rewrite_for_pg(sql, table)
    try:
        with _pg_conn() as conn:
            with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
                cur.execute(rewritten)
                rows = cur.fetchall()
        result = [dict(r) for r in rows]
        # Normalise datetime objects to ISO strings (match AnyLog REST format)
        for row in result:
            for k, v in row.items():
                if isinstance(v, datetime):
                    row[k] = v.strftime("%Y-%m-%d %H:%M:%S")
        return result
    except Exception as exc:
        logger.error("_pg_query error — sql=%.120s — error=%s", sql, exc)
        return []


# ─── Core public helper (now postgres-backed) ─────────────────────────────────

def anylog_query(
    sql: str,
    anylog_url: str = ANYLOG_URL,
    timeout: int = 60,
    table: str = ANYLOG_TABLE_LIVE,
) -> list[dict]:
    """
    Execute a SQL query.  Uses postgres directly (AnyLog REST times out).
    The `anylog_url` and `timeout` params are kept for interface compatibility
    but are ignored for SELECT queries.
    """
    return _pg_query(sql, table=table)


def anylog_admin(command: str, anylog_url: str = ANYLOG_URL, timeout: int = 30) -> str:
    """Send a local admin command to AnyLog REST (no destination:network)."""
    req = urllib.request.Request(anylog_url)
    req.add_header("User-Agent", ANYLOG_USER_AGENT)
    req.add_header("command",    command)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read().decode("utf-8", errors="replace")
    except Exception as exc:
        logger.error("anylog_admin failed — cmd=%s error=%s", command, exc)
        return ""


def fetch_channel(
    channel: str,
    start_iso: str,
    end_iso: str,
    table: str = ANYLOG_TABLE_LIVE,
    anylog_url: str = ANYLOG_URL,
) -> list[dict]:
    """
    Fetch rows for a single channel between two ISO timestamps.
    Paren channels use a time-only fetch + client-side filter.
    """
    if channel in PAREN_CHANNELS:
        sql = (
            f"SELECT ts, nm, w FROM {table} "
            f"WHERE ts >= '{start_iso}' AND ts <= '{end_iso}' "
            f"ORDER BY ts ASC"
        )
        rows = anylog_query(sql, anylog_url=anylog_url)
        return [r for r in rows if r.get("nm") == channel]

    sql = (
        f"SELECT ts, nm, w FROM {table} "
        f"WHERE nm = '{channel}' "
        f"AND ts >= '{start_iso}' AND ts <= '{end_iso}' "
        f"ORDER BY ts ASC"
    )
    return anylog_query(sql, anylog_url=anylog_url)


def fetch_recent_window(
    channel: str,
    minutes: int = 30,
    table: str = ANYLOG_TABLE_LIVE,
    anylog_url: str = ANYLOG_URL,
) -> list[dict]:
    """
    Fetch the last N minutes of data for a single channel.
    Paren channels (Panel1/2/3) use the time-only fetch + client-side
    filter workaround for the parser quirk documented in
    docs/anylog_query_cookbook.md.
    """
    if channel in PAREN_CHANNELS:
        sql = (
            f"SELECT ts, nm, w FROM {table} "
            f"WHERE ts > NOW() - {minutes} minutes "
            f"ORDER BY ts ASC"
        )
        rows = anylog_query(sql, anylog_url=anylog_url)
        return [r for r in rows if r.get("nm") == channel]

    sql = (
        f"SELECT ts, nm, w FROM {table} "
        f"WHERE nm = '{channel}' "
        f"AND ts > NOW() - {minutes} minutes "
        f"ORDER BY ts ASC"
    )
    return anylog_query(sql, anylog_url=anylog_url)


def fetch_all_panels_recent(
    minutes: int = 30,
    anylog_url: str = ANYLOG_URL,
    table: str = ANYLOG_TABLE_LIVE,
) -> dict[str, list[dict]]:
    """
    Fetch last N minutes for all IEMS panels in a single round-trip.
    One time-bounded query, then partition rows by `nm` client-side.
    Sidesteps both the IN-clause parser bug and the per-channel paren bug.
    """
    sql = (
        f"SELECT ts, nm, w FROM {table} "
        f"WHERE ts > NOW() - {minutes} minutes "
        f"ORDER BY ts ASC"
    )
    rows = anylog_query(sql, anylog_url=anylog_url)
    result: dict[str, list[dict]] = {p: [] for p in IEMS_PANELS}
    for r in rows:
        nm = r.get("nm")
        if nm in result:
            result[nm].append(r)
    return result


def fetch_all_panels(
    start_iso: str,
    end_iso: str,
    anylog_url: str = ANYLOG_URL,
    table: str = ANYLOG_TABLE_LIVE,
) -> dict[str, list[dict]]:
    """
    Fetch rows for all IEMS panels between two ISO timestamps.
    Same workaround as fetch_all_panels_recent: one time-bounded query,
    partition by `nm` client-side.
    """
    sql = (
        f"SELECT ts, nm, w FROM {table} "
        f"WHERE ts >= '{start_iso}' AND ts <= '{end_iso}' "
        f"ORDER BY ts ASC"
    )
    rows = anylog_query(sql, anylog_url=anylog_url)
    result: dict[str, list[dict]] = {p: [] for p in IEMS_PANELS}
    for r in rows:
        nm = r.get("nm")
        if nm in result:
            result[nm].append(r)
    return result


def fetch_distinct_channels(
    table: str = ANYLOG_TABLE_LIVE,
    anylog_url: str = ANYLOG_URL,
) -> list[str]:
    sql = f"SELECT DISTINCT nm FROM {table} ORDER BY nm"
    rows = anylog_query(sql, anylog_url=anylog_url)
    return [r["nm"] for r in rows if "nm" in r]


def insert_predictions(
    predictions: list[dict],
    table: str = ANYLOG_TABLE_NILM,
    anylog_url: str = ANYLOG_URL,
) -> bool:
    """
    Insert NILM disaggregated predictions into nilm_disaggregated.

    Each prediction dict must have these keys (matching discovered schema):
      ts, circuit, appliance, state, confidence,
      avg_w, median_w, std_w, window_start, window_end, window_n

    Uses AnyLog streaming ingestion: PUT / with command header.
    """
    if not predictions:
        return True

    # AnyLog streaming PUT prepends member_id + seq_no before JSON fields,
    # causing positional column mis-mapping (ts gets member_id=180, etc.).
    # Write directly to postgres via psycopg2 instead.
    COLS = ("ts", "circuit", "appliance", "state", "confidence",
            "avg_w", "median_w", "std_w", "window_start", "window_end", "window_n")
    rows = [tuple(p.get(c) for c in COLS) for p in predictions]
    placeholders = ",".join(["%s"] * len(COLS))
    sql = f"INSERT INTO {table} ({','.join(COLS)}) VALUES ({placeholders})"
    try:
        with _pg_conn() as conn:
            with conn.cursor() as cur:
                cur.executemany(sql, rows)
        logger.debug("insert_predictions wrote %d rows to %s", len(rows), table)
        return True
    except Exception as exc:
        logger.error("insert_predictions failed: %s", exc)
        return False


def resample_to_6s(rows: list[dict]) -> list[dict]:
    """
    Resample rows (any interval) to 6-second grid via linear interpolation.
    LLM4NILM paper standard input cadence.
    """
    if len(rows) < 2:
        return rows

    resampled = []
    for i in range(len(rows) - 1):
        t0 = _parse_ts(rows[i]["ts"])
        t1 = _parse_ts(rows[i + 1]["ts"])
        w0 = _tofloat(rows[i].get("w", 0))
        w1 = _tofloat(rows[i + 1].get("w", 0))
        span_s = max(0.001, (t1 - t0).total_seconds())
        steps = max(1, round(span_s / 6))
        for s in range(steps):
            frac = s / steps
            resampled.append({
                "ts": _ts_str(t0 + (t1 - t0) * frac),
                "w": round(w0 + (w1 - w0) * frac, 2),
            })

    resampled.append({"ts": rows[-1]["ts"], "w": _tofloat(rows[-1].get("w", 0))})
    return resampled


def health_check(anylog_url: str = ANYLOG_URL) -> dict:
    """
    Ping AnyLog: count rows in egauge_kafka in the last 5 minutes,
    and report the freshness of the most recent row.
    Returns {ok, row_count_5min, latest_ts, staleness_s, error?}
    """
    rows = anylog_query(
        f"SELECT MAX(ts) as latest, COUNT(*) as cnt FROM {ANYLOG_TABLE_LIVE} "
        f"WHERE ts > NOW() - 5 minutes",
        anylog_url=anylog_url,
    )
    if not rows:
        return {"ok": False, "error": "No response from AnyLog"}

    r = rows[0]
    latest_str = r.get("latest") or r.get("max(ts)", "")
    cnt = int(r.get("cnt") or r.get("count(*)", 0) or 0)

    staleness_s = None
    if latest_str:
        try:
            latest_dt = _parse_ts(latest_str)
            staleness_s = round((datetime.now(timezone.utc) - latest_dt).total_seconds())
        except Exception:
            pass

    ok = cnt > 0 and (staleness_s is None or staleness_s < 120)
    return {
        "ok": ok,
        "row_count_5min": cnt,
        "latest_ts": latest_str,
        "staleness_s": staleness_s,
    }


def build_nilm_predictions(
    panel: str,
    appliance_states: dict[str, list[int]],
    timestamps: list[str],
    power_values: list[float],
    window_start: str,
    window_end: str,
    model: str = "mistral:7b",
) -> list[dict]:
    """
    Convert per-appliance binary state arrays to nilm_disaggregated rows.
    Uses the ACTUAL discovered schema.
    """
    records = []
    n = len(timestamps)

    for appliance, states in appliance_states.items():
        if appliance == "vacuum_cleaner_status":
            appliance = "vacuum_cleaner"
        else:
            appliance = appliance.replace("_status", "")

        for i, state in enumerate(states):
            if i >= n:
                break
            ts = timestamps[i] if i < len(timestamps) else window_end

            # compute stats from the surrounding window
            lo = max(0, i - 5)
            hi = min(len(power_values), i + 5)
            window_w = [abs(power_values[j]) for j in range(lo, hi) if j < len(power_values)]
            avg_w = round(statistics.mean(window_w), 2) if window_w else 0.0
            median_w = round(statistics.median(window_w), 2) if window_w else 0.0
            std_w = round(statistics.stdev(window_w), 2) if len(window_w) > 1 else 0.0

            records.append({
                "ts":           ts,
                "circuit":      panel,
                "appliance":    appliance,
                "state":        "ON" if state == 1 else "OFF",
                "confidence":   0.75,
                "avg_w":        avg_w,
                "median_w":     median_w,
                "std_w":        std_w,
                "window_start": window_start,
                "window_end":   window_end,
                "window_n":     n,
            })

    return records


# ─── Internal helpers ─────────────────────────────────────────────────────────

def _parse_ts(ts_str: str) -> datetime:
    for fmt in (
        "%Y-%m-%d %H:%M:%S.%f",
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%dT%H:%M:%S.%f",
        "%Y-%m-%dT%H:%M:%S",
    ):
        try:
            return datetime.strptime(ts_str, fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            continue
    raise ValueError(f"Cannot parse timestamp: {ts_str!r}")


def _ts_str(dt: datetime) -> str:
    return dt.strftime("%Y-%m-%d %H:%M:%S.%f")


def _tofloat(v) -> float:
    try:
        return float(v)
    except (TypeError, ValueError):
        return 0.0
