# ─────────────────────────────────────────────────────────────────────────────
# Microgrid IEMS settings
# Copy this file to .env (the setup script does it for you) and fill it in.
# docker-compose.yaml reads every value below when the stack starts.
# Lines starting with # are comments.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. What to run ──────────────────────────────────────────────────────────
# demo   plays a recorded scenario, no meter or inverter needed (start here)
# live   reads a real eGauge meter and a real Solar Assistant
# gui    adds the AnyLog Remote GUI with the IEMS page on port 3001
# tools  adds kafka-ui on port 8080
# Combine with commas, for example  COMPOSE_PROFILES=live,gui
COMPOSE_PROFILES=demo

# Scenario for the demo profile. Any folder name under tests/scenarios/output/
# baseline_normal  grid_outage_islanded  full_blackout  generator_backup
# psps_low_soc  meter_dropout  frozen_values  ct_sign_flip  month_rollover  brownout_sag
DEMO_SCENARIO=baseline_normal
# 1 is real time. 2 plays twice as fast.
DEMO_SPEED=1

# ── 2. AnyLog (required) ────────────────────────────────────────────────────
# The AnyLog nodes will not start without a license key. Ask the AnyLog team
# (https://anylog.network) for one and paste it on one line, keeping any
# trailing {...} part exactly as you received it.
ANYLOG_LICENSE=
# AnyLog image. 2.1.2608 is the version the live site runs and it is published
# for both Intel/AMD (amd64) and Apple Silicon or Raspberry Pi (arm64).
ANYLOG_IMAGE=anylogco/anylog-network:2.1.2608
# Optional Akave object storage for AnyLog blobs. Leave empty if unused.
AKAVE_ACCESS_KEY_RC2=
AKAVE_SECRET_KEY_RC2=
AKAVE_ENDPOINT_RC2=

# ── 3. Database ─────────────────────────────────────────────────────────────
# The AnyLog operator logs in as demo / passwd, which is created on first
# start by streaming/postgres/init/01-ensure-demo-user.sql. If you change the
# password here, change DB_PASSWD in
# streaming/anylog/docker-makefiles/operator1-configs/base_configs.env as well.
POSTGRES_USER=admin
POSTGRES_PASSWORD=passwd
POSTGRES_DB=customers

# ── 4. The house ────────────────────────────────────────────────────────────
# Used for sun position, clear sky irradiance and weather (Open-Meteo, no key).
HOUSE_LAT=37.23
HOUSE_LON=-121.96
HOUSE_TZ=America/Los_Angeles

# ── 5. Real hardware (profile live only) ───────────────────────────────────
# eGauge meter. URI is the meter's address, user and password come from the
# meter's admin page.
EGAUGE_URI=https://egaugeXXXXX.egaug.es
EGAUGE_USER=owner
EGAUGE_PASS=
# Solar Assistant MQTT broker on your network (Solar Assistant, Configuration,
# MQTT). SA_BROKER is its IP address or host name.
SA_BROKER=
SA_PORT=1883
SA_USER=
SA_PASS=
SA_PREFIX=solar_assistant
# Home Assistant for the thermostat controls, for example
# http://homeassistant.local:8123. Put a long lived access token in
# config/ha_token.txt. Leave HA_URL empty if you have no Home Assistant.
HA_URL=

# ── 6. Local language model for Ask ────────────────────────────────────────
# qwen2.5:1.5b-instruct needs about 1.1 GB of memory. On a machine with
# 16 GB or more, qwen2.5:3b-instruct gives better written answers.
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# ── 7. Ports on your computer ──────────────────────────────────────────────
# Change one of these only if the start script reports it as busy.
DASHBOARD_PORT=47821
BACKEND_PORT=8009
GUI_PORT=3001
GUI_API_PORT=8000
KAFKA_UI_PORT=8080
OLLAMA_PORT=11434
# These are fixed because the AnyLog nodes reach each other through them.
# 5432 Postgres, 9092 and 9094 Kafka, 32048 and 32049 AnyLog master,
# 32148, 32149 and 1883 AnyLog operator.

# ── 8. Inference ────────────────────────────────────────────────────────────
# How often the appliance models run, in seconds.
INFERENCE_TICK_SECONDS=30
