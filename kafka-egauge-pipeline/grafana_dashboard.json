      "id": 1,
      "title": "Grid Power",
      "description": "Total power drawn from or fed to the utility grid",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "spanNulls": false,
            "axisCenteredZero": true,
            "axisLabel": "Watts"
          },
          "unit": "watt",
          "displayName": "Grid Power"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "bffk64c6007wgf" },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "url": "http://localhost:32149",
          "url_options": {
            "method": "GET",
            "headers": [
              { "name": "User-Agent", "value": "AnyLog/1.23" },
              { "name": "destination", "value": "network" },
              { "name": "command", "value": "run client () sql customers format = json \"SELECT ts, w FROM egauge_kafka WHERE nm = 'Grid Power' AND ts > now() - 1 day ORDER BY ts DESC\"" }
            ]
          },
          "root_selector": "Query",
          "columns": [
            { "text": "ts", "selector": "ts", "type": "timestamp" },
            { "text": "w", "selector": "w", "type": "number" }
          ],
          "parser": "backend",
          "filters": [],
          "global_query_id": ""
